# -- AI Copilot --
# Get your free key from https://console.groq.com
GROQ_API_KEY=gsk_...

# Anthropic key (optional fallback)
ANTHROPIC_API_KEY=

# -- Hugging Face (for anomaly model on Render) --
# Set this after running: python3 scripts/upload_anomaly_to_hf.py
HF_REPO_ID=YourUsername/lpie-models
# HF_TOKEN=hf_...  # only needed if repo is private

# -- API Server --
API_HOST=0.0.0.0
API_PORT=8000

# -- Frontend --
NEXT_PUBLIC_API_URL=http://localhost:8000
# On production, use your Render URL:
# NEXT_PUBLIC_API_URL=https://lpie-backend.onrender.com
