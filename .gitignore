# =============================================================================
# LPIE — only source code, configuration, trained models and reports are
# tracked. Everything generated, downloaded, secret or machine-local is ignored.
# =============================================================================

# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Datasets ───────────────────────────────────────────────────────────
# The panel CSVs are committed (Render's build loads them into the feature
# store live) — see scripts/generate_datasets.py to regenerate them.
dataset/hmda_raw/
dataset/*.log
*.csv.gz
*.zip

# ── Derived stores (rebuild with `make data && make features`) ───────────
artifacts/store/
artifacts/mlruns/
mlruns/

# ── Logs and scratch output ──────────────────────────────────────────────
logs/
*.log
loadtest/
.shots/

# ── Node / Next.js ───────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*

# ── Notebooks ────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Agent / editor / OS tooling ──────────────────────────────────────────
.claude/
.agents/
.playwright-mcp/
mcp-config/
skills-lock.json
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Internal working docs — not part of the submission
docs/
MODEL_CARD.md
AI_DEVELOPMENT_LOG.md
